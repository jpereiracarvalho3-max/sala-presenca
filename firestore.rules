rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Administrador: quem está gravado em config/owner
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/owner)
        && get(/databases/$(database)/documents/config/owner).data.uid == me();
    }

    // Membro aprovado pelo administrador
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/approvals/$(me()))
        && get(/databases/$(database)/documents/approvals/$(me())).data.status == 'aprovado';
    }
    function myMemberId() {
      return get(/databases/$(database)/documents/approvals/$(me())).data.memberId;
    }
    function isLeaderOf(eventId) {
      return isMember()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.leaderId == myMemberId();
    }
    function inside() { return isOwner() || isMember(); }

    // O primeiro a entrar vira administrador; depois ninguém troca pelo app
    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update, delete: if false;
    }
    match /config/rules {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Lista de nomes: visível para quem entrou, para poder pedir acesso
    match /members/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Pedidos de acesso e perfil: cada um escreve só o seu
    match /claims/{u} {
      allow read: if signedIn();
      allow create, update: if signedIn() && u == me();
      allow delete: if isOwner() || (signedIn() && u == me());
    }
    match /approvals/{u} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /avatars/{u} {
      allow read: if signedIn();
      allow write: if signedIn() && u == me();
    }
    match /profiles/{u} {
      allow read: if signedIn();
      allow write: if signedIn() && u == me();
    }

    // Eventos, presenças e justificativas: só o administrador e membros aprovados veem
    // Qualquer membro aprovado cria evento (e vira o líder) e edita o que criou; só o administrador troca o líder ou apaga
    match /events/{id} {
      allow read: if inside();
      allow create: if isOwner() || (isMember() && request.resource.data.createdBy == me() && request.resource.data.leaderId == myMemberId());
      allow update: if isOwner() || (isMember() && resource.data.createdBy == me() && request.resource.data.createdBy == me() && request.resource.data.leaderId == resource.data.leaderId);
      allow delete: if isOwner();
    }
    match /ctl/{eventId} {
      allow read: if inside();
      allow write: if isOwner() || isLeaderOf(eventId);
    }
    match /checkins/{key} {
      allow read: if inside();
      allow create, update: if isOwner()
        || isLeaderOf(request.resource.data.eventId)
        || (isMember()
            && request.resource.data.memberId == myMemberId()
            && key == request.resource.data.eventId + '_' + request.resource.data.memberId);
      allow delete: if isOwner() || isLeaderOf(resource.data.eventId);
    }
    // Sala de jogos: a partida fica visível para os membros; a mão de cada um só o dono lê
    match /games/{id} {
      allow read, write: if inside();
    }
    match /hands/{id} {
      allow read: if inside() && id.matches('.*_' + me());
      allow write: if inside();
    }
    // Racha, recados e enquetes de cada evento: só membros leem; cada um cria o seu; no racha e na enquete os outros só mexem na parte de pagamento e de voto
    match /splits/{id} {
      allow read: if inside();
      allow create: if inside() && request.resource.data.uid == me();
      allow update: if isOwner() || resource.data.uid == me()
        || (inside() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partes']));
      allow delete: if isOwner() || resource.data.uid == me();
    }
    // Link para pessoa de fora do grupo (racha ou sorteio do evento): quem tem o link (chave longa e aleatória) vê só aquele racha, até vencer,
    // e só consegue avisar "já paguei". Quem criou o racha (ou o administrador) cria, confirma e apaga.
    match /convites/{k} {
      allow get: if inside() || resource.data.exp > request.time.toMillis();
      allow list: if inside();
      allow create: if inside() && request.resource.data.uid == me();
      allow update: if isOwner() || (signedIn() && resource.data.uid == me())
        || (resource.data.exp > request.time.toMillis()
            && resource.data.st == 'devendo'
            && request.resource.data.st == 'avisou'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'at']))
        // Sorteio do evento (amigo oculto): a pessoa de fora só escreve as próprias dicas pelo link dela;
        // os integrantes só atualizam a cópia das dicas de quem ela tirou
        || (resource.data.exp > request.time.toMillis()
            && resource.data.get('tipo', '') == 'amigo'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dica'])
            && request.resource.data.dica is string
            && request.resource.data.dica.size() <= 300)
        || (inside()
            && resource.data.get('tipo', '') == 'amigo'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dicaDele']));
      allow delete: if isOwner() || (signedIn() && resource.data.uid == me());
    }
    match /posts/{id} {
      allow read: if inside();
      allow create: if inside() && request.resource.data.uid == me();
      allow delete: if isOwner() || resource.data.uid == me() || isLeaderOf(resource.data.eventId);
    }
    match /polls/{id} {
      allow read: if inside();
      allow create: if inside() && request.resource.data.uid == me();
      allow update: if isOwner() || resource.data.uid == me()
        || (inside() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votos']));
      allow delete: if isOwner() || resource.data.uid == me();
    }
    // Chat geral: membros leem e escrevem; cada um apaga o que é seu e qualquer membro apaga mensagens com mais de 2 horas
    match /chat/{id} {
      allow read: if inside();
      allow create: if inside() && request.resource.data.uid == me();
      allow delete: if isOwner() || resource.data.uid == me()
        || (inside() && resource.data.at < request.time.toMillis() - 7200000);
    }
    match /chataudio/{id} {
      allow read: if inside();
      allow create: if inside() && request.resource.data.uid == me();
      allow delete: if isOwner() || resource.data.uid == me()
        || (inside() && resource.data.at < request.time.toMillis() - 7200000);
    }
    // Notificações no celular: cada um grava o registro do próprio aparelho; os avisos entram numa fila que só o robô de envio lê
    match /tokens/{u} {
      allow read, write: if signedIn() && u == me();
    }
    match /outbox/{id} {
      allow create: if inside() && request.resource.data.uid == me();
      allow delete: if isOwner() || resource.data.uid == me();
    }
    match /justifs/{key} {
      allow read: if inside();
      allow create: if isMember()
        && request.resource.data.memberId == myMemberId()
        && key == request.resource.data.eventId + '_' + request.resource.data.memberId;
      // decisão: administrador ou líder do evento; voto: qualquer membro, só no campo de votos
      allow update: if isOwner()
        || isLeaderOf(resource.data.eventId)
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']));
      allow delete: if isOwner();
    }
  }
}
